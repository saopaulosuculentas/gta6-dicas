---
import Base from '../layouts/Base.astro';
import Selo from '../components/Selo.astro';
import Anuncio from '../components/Anuncio.astro';
import Lateral from '../components/Lateral.astro';
import { CATEGORIAS } from '../../site.config.mjs';
import { u, todasDicas, dataLonga, hora, linkDica, type Dica } from '../lib/util';

const dicas = await todasDicas();
const dias = new Map<string, Dica[]>();
for (const d of dicas) {
  const dia = dataLonga(d.data.atualizado_em);
  dias.set(dia, [...(dias.get(dia) ?? []), d]);
}
---

<Base titulo="Novidades: o que entrou por último" descricao="Linha do tempo de tudo que foi descoberto no GTA 6: códigos, easter eggs e segredos, na ordem em que apareceram.">
  <header class="cabeca-pagina miolo">
    <nav class="trilho" aria-label="Você está em"><a href={u('/')}>Início</a> <span>/</span> <span>Novidades</span></nav>
    <h1>Novidades</h1>
    <p>Tudo que entrou ou mudou no site, do mais novo para o mais antigo.</p>
  </header>
  <div class="miolo"><Anuncio formato="faixa" /></div>
  <div class="miolo duas">
    <main>
      {
        dicas.length === 0 && (
          <div class="aviso">
            <h3>A linha do tempo começa no lançamento</h3>
            <p>O GTA 6 sai em 19 de novembro de 2026. As primeiras descobertas aparecem aqui no mesmo dia.</p>
          </div>
        )
      }
      {
        [...dias.entries()].map(([dia, lista]) => (
          <section>
            <h2 class="dia">{dia}</h2>
            <ol class="linha-do-tempo">
              {lista.map((d) => (
                <li>
                  <time datetime={d.data.atualizado_em.toISOString()}>{hora(d.data.atualizado_em)}</time>
                  <span class="etiqueta" style="margin-left: 10px">{CATEGORIAS[d.data.categoria].nome}</span>
                  <h3><a href={linkDica(d)}>{d.data.titulo}</a></h3>
                  <p>{d.data.resumo}</p>
                  <Selo status={d.data.status} />
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </main>
    <Lateral />
  </div>
</Base>
