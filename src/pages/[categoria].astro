---
import Base from '../layouts/Base.astro';
import Cartao from '../components/Cartao.astro';
import Anuncio from '../components/Anuncio.astro';
import Lateral from '../components/Lateral.astro';
import TabelaCodigos from '../components/TabelaCodigos.astro';
import SemCodigos from '../components/SemCodigos.astro';
import { CATEGORIAS } from '../../site.config.mjs';
import { u, todasDicas } from '../lib/util';

export function getStaticPaths() {
  return Object.keys(CATEGORIAS).map((categoria) => ({ params: { categoria } }));
}
const { categoria } = Astro.params as { categoria: keyof typeof CATEGORIAS };
const c = CATEGORIAS[categoria];
const dicas = (await todasDicas()).filter((d) => d.data.categoria === categoria);
const ehCodigos = categoria === 'codigos';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(u('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: c.nome, item: new URL(u(`/${categoria}/`), Astro.site).href },
  ],
};
---

<Base titulo={c.titulo} descricao={c.descricao} jsonld={jsonld}>
  <header class="cabeca-pagina miolo">
    <nav class="trilho" aria-label="Você está em"><a href={u('/')}>Início</a> <span>/</span> <span>{c.nome}</span></nav>
    <h1>{c.titulo}</h1>
    <p>{c.descricao}</p>
  </header>

  <div class="miolo"><Anuncio formato="faixa" /></div>

  <div class="miolo duas">
    <main>
      {
        ehCodigos && (
          <section class="secao">
            {dicas.length ? <TabelaCodigos dicas={dicas} /> : <SemCodigos />}
          </section>
        )
      }
      {
        !ehCodigos && (
          <section class="secao">
            {dicas.length ? (
              <div class="grade">
                {dicas.map((d, i) => (
                  <>
                    <Cartao dica={d} />
                    {i === 3 && <Anuncio formato="grade" />}
                  </>
                ))}
              </div>
            ) : (
              <div class="aviso">
                <h3>Nada confirmado aqui ainda</h3>
                <p>O GTA 6 sai em 19 de novembro de 2026. Esta página enche conforme as descobertas aparecem em vídeos e lives, sempre com a fonte.</p>
              </div>
            )}
          </section>
        )
      }
      {ehCodigos && dicas.length > 0 && <Anuncio formato="artigo" />}
      {
        ehCodigos && (
          <section class="secao texto">
            <h2>Como usar código no GTA 6</h2>
            <p>
              Esta parte é atualizada assim que o primeiro código for mostrado funcionando: onde digitar, se o código desliga troféus e conquistas e
              se vale para o modo online. Até lá, vale o que aconteceu em todos os GTA anteriores: código é coisa do modo história.
            </p>
          </section>
        )
      }
    </main>
    <Lateral />
  </div>
</Base>
