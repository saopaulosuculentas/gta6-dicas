---
import Categoria from '../views/Categoria.astro';
import { CATEGORIAS } from '../../site.config.mjs';
import type { Categoria as Cat } from '../lib/i18n';

export function getStaticPaths() {
  return Object.keys(CATEGORIAS).map((categoria) => ({ params: { categoria } }));
}
const { categoria } = Astro.params as { categoria: Cat };
---

<Categoria lang="pt" categoria={categoria} />
