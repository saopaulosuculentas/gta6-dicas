---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Selo from '../../components/Selo.astro';
import Botoes from '../../components/Botoes.astro';
import Cartao from '../../components/Cartao.astro';
import Anuncio from '../../components/Anuncio.astro';
import VideoNoPonto from '../../components/VideoNoPonto.astro';
import { SITE, CATEGORIAS } from '../../../site.config.mjs';
import { u, todasDicas, canais, dataHora, dataLonga, linkNoMinuto, slugDe, linkDica, type Dica } from '../../lib/util';

export async function getStaticPaths() {
  const dicas = await todasDicas();
  return dicas.map((dica) => ({ params: { slug: slugDe(dica) }, props: { dica } }));
}
const { dica } = Astro.props as { dica: Dica };
const d = dica.data;
const { Content } = await render(dica);
const c = CATEGORIAS[d.categoria];
const n = canais(dica).length;
const video = d.fontes.find((f) => f.tipo === 'youtube');
const outras = (await todasDicas()).filter((x) => x.id !== dica.id && x.data.categoria === d.categoria).slice(0, 3);
const endereco = new URL(linkDica(dica), Astro.site).href;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.titulo,
    description: d.resumo,
    datePublished: d.descoberto_em.toISOString(),
    dateModified: d.atualizado_em.toISOString(),
    inLanguage: 'pt-BR',
    mainEntityOfPage: endereco,
    author: { '@type': 'Organization', name: SITE.nome },
    publisher: { '@type': 'Organization', name: SITE.nome },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL(u('/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: c.nome, item: new URL(u(`/${d.categoria}/`), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.titulo, item: endereco },
    ],
  },
];
---

<Base titulo={d.titulo} descricao={d.resumo} tipo="article" jsonld={jsonld} noindex={dica.id.startsWith('exemplos/')}>
  <div class="miolo"><Anuncio formato="faixa" /></div>
  <div class="miolo dica">
    <main>
      <header class="dica__cabeca">
        <nav class="trilho" aria-label="Você está em">
          <a href={u('/')}>Início</a> <span>/</span> <a href={u(`/${d.categoria}/`)}>{c.nome}</a>
        </nav>
        <h1>{d.titulo}</h1>
        <p class="dica__resumo">{d.resumo}</p>
        <div class="dica__meta">
          <Selo status={d.status} canais={n} />
          <span>Atualizado em <time datetime={d.atualizado_em.toISOString()}>{dataHora(d.atualizado_em)}</time></span>
          <span>{d.plataformas.map((p) => (p === 'ps5' ? 'PS5' : 'Xbox Series')).join(' e ')}</span>
        </div>
      </header>

      {
        d.codigo && (
          <section class="bloco-codigo" aria-label="Código">
            <dl>
              {d.codigo.ps5 && (<div><dt>PS5</dt><dd><Botoes console="ps5" seq={d.codigo.ps5} /></dd></div>)}
              {d.codigo.xbox && (<div><dt>Xbox Series</dt><dd><Botoes console="xbox" seq={d.codigo.xbox} /></dd></div>)}
              {d.codigo.telefone && (<div><dt>No celular do jogo</dt><dd>{d.codigo.telefone}</dd></div>)}
              {d.codigo.texto && (<div><dt>Como ativar</dt><dd>{d.codigo.texto}</dd></div>)}
            </dl>
            {d.efeito && <p class="efeito"><strong>O que faz:</strong> {d.efeito}</p>}
          </section>
        )
      }

      <article class="texto"><Content /></article>

      <Anuncio formato="artigo" />

      {video && <VideoNoPonto url={video.url} canal={video.canal} minuto={video.minuto} titulo={video.titulo} />}

      {
        outras.length > 0 && (
          <section class="secao" aria-labelledby="s-mais">
            <div class="secao__cabeca"><h2 id="s-mais">Mais em {c.nome}</h2></div>
            <div class="grade">{outras.map((o) => <Cartao dica={o} />)}</div>
          </section>
        )
      }
    </main>

    <aside class="lateral">
      <div class="caixa">
        <h2>De onde veio</h2>
        <ul class="fontes">
          {
            d.fontes.map((f) => (
              <li>
                <b>{f.canal}{f.tipo === 'oficial' ? ' (oficial)' : ''}</b>
                <a href={f.tipo === 'youtube' ? linkNoMinuto(f.url, f.minuto) : f.url} target="_blank" rel="noopener nofollow">
                  {f.titulo ?? 'Abrir a fonte'}{f.minuto ? ` (minuto ${f.minuto})` : ''}
                </a>
                <small>{dataLonga(f.data)}</small>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="caixa">
        <h2>Situação</h2>
        {
          d.status === 'confirmado' ? (
            <p><strong style="color: var(--menta)">Confirmado.</strong> A dica apareceu funcionando em {n} fontes diferentes{d.fontes.some((f) => f.tipo === 'oficial') ? ', incluindo fonte oficial' : ''}.</p>
          ) : (
            <p><strong style="color: var(--ambar)">Em verificação.</strong> Por enquanto só uma fonte mostrou. Se outra confirmar, o selo muda; se cair, a dica sai do ar.</p>
          )
        }
        {
          d.historico.length > 0 && (
            <ul class="historico">
              {d.historico.map((h) => <li><time datetime={h.data.toISOString()}>{dataHora(h.data)}</time>{h.nota}</li>)}
            </ul>
          )
        }
      </div>
      <Anuncio formato="arranha" />
    </aside>
  </div>
</Base>
