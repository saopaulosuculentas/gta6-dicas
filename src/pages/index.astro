---
import Base from '../layouts/Base.astro';
import Cartao from '../components/Cartao.astro';
import Anuncio from '../components/Anuncio.astro';
import Lateral from '../components/Lateral.astro';
import TabelaCodigos from '../components/TabelaCodigos.astro';
import SemCodigos from '../components/SemCodigos.astro';
import { SITE, CATEGORIAS } from '../../site.config.mjs';
import { u, todasDicas, hora, dataHora, linkDica } from '../lib/util';

const dicas = await todasDicas();
const confirmadas = dicas.filter((d) => d.data.status === 'confirmado').length;
const codigos = dicas.filter((d) => d.data.categoria === 'codigos');
const hoje = new Date().toDateString();
const plantao = dicas.slice(0, 6);
const ultimas = dicas.slice(0, 12);
const conta = (slug: string) => dicas.filter((d) => d.data.categoria === slug).length;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nome,
  description: SITE.descricao,
  url: new URL(u('/'), Astro.site).href,
  inLanguage: 'pt-BR',
};
---

<Base jsonld={jsonld}>
  <section class="capa miolo">
    <div>
      <span class="olho sobe">GTA 6 em português</span>
      <h1 class="sobe">Todo código do GTA 6, <span class="sol">conferido</span> antes de ir ao ar</h1>
      <p class="lide sobe">
        Códigos, easter eggs, segredos e jeitos de ganhar dinheiro. Cada dica mostra o vídeo de onde saiu e um selo dizendo se já foi confirmada.
      </p>
      <div class="numeros sobe">
        <div class="numero"><b>{dicas.length}</b><span>dicas no ar</span></div>
        <div class="numero numero--menta"><b>{confirmadas}</b><span>confirmadas</span></div>
        <div class="numero numero--ambar"><b>{dicas.length - confirmadas}</b><span>em verificação</span></div>
      </div>
    </div>
    <aside class="plantao sobe" aria-labelledby="plantao-t">
      <h2 id="plantao-t">Plantão <small>o que entrou por último</small></h2>
      {
        plantao.length ? (
          <ol>
            {plantao.map((d) => (
              <li>
                <a href={linkDica(d)}>
                  <time datetime={d.data.atualizado_em.toISOString()}>{d.data.atualizado_em.toDateString() === hoje ? hora(d.data.atualizado_em) : dataHora(d.data.atualizado_em).slice(0, 5)}</time>
                  <span>{d.data.titulo}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="vazio">Nada publicado ainda. As primeiras descobertas entram assim que o jogo sair, no dia 19/11.</p>
        )
      }
    </aside>
  </section>

  <div class="miolo"><Anuncio formato="faixa" /></div>

  <div class="miolo duas">
    <main>
      <section class="secao" aria-labelledby="s-codigos">
        <div class="secao__cabeca">
          <h2 id="s-codigos">Códigos</h2>
          {codigos.length > 0 && <a href={u('/codigos/')}>Ver os {codigos.length} códigos →</a>}
        </div>
        {codigos.length ? <TabelaCodigos dicas={codigos.slice(0, 6)} /> : <SemCodigos />}
      </section>

      {
        ultimas.length > 0 && (
          <section class="secao" aria-labelledby="s-ultimas">
            <div class="secao__cabeca">
              <h2 id="s-ultimas">Últimas descobertas</h2>
              <a href={u('/novidades/')}>Linha do tempo →</a>
            </div>
            <div class="grade">
              {ultimas.map((d, i) => (
                <>
                  <Cartao dica={d} />
                  {i === 3 && <Anuncio formato="grade" />}
                </>
              ))}
            </div>
          </section>
        )
      }
    </main>
    <Lateral />
  </div>

  <div class="fita" role="presentation"></div>

  <section class="secao miolo" aria-labelledby="s-trilhas">
    <div class="secao__cabeca"><h2 id="s-trilhas">Por assunto</h2></div>
    <div class="trilhas">
      {
        Object.entries(CATEGORIAS).map(([slug, c], i) => (
          <a class="trilha" href={u(`/${slug}/`)}>
            <div>
              <h3>{c.nome}</h3>
              <p>{c.chamada}</p>
            </div>
            <span class="trilha__conta">{conta(slug) === 0 ? 'em breve' : `${conta(slug)} ${conta(slug) === 1 ? 'dica' : 'dicas'}`}</span>
            <span class="trilha__n" aria-hidden="true">0{i + 1}</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="miolo"><Anuncio formato="faixa" /></div>
</Base>
