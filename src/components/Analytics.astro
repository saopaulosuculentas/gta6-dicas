---
// Google Analytics com consentimento (modo básico do Google):
// - Europa: o Analytics nem é baixado até o aviso do AdSense dizer que a pessoa aceitou (ou que a lei não se aplica a ela).
// - Resto do mundo: carrega na hora, como sempre.
// O aceite só chega aqui com "Enable consent mode for analytics purposes" ligado no AdSense
// (Privacy & messaging > European regulations > Settings). Desligado, a visita europeia não é contada.
// Referência: https://developers.google.com/funding-choices/fc-api-docs#using-google-consent-consent-mode
interface Props { id: string }
const { id } = Astro.props;
---

<script is:inline define:vars={{ gaId: id }}>
  (function () {
    var ACEITOU = 1, RECUSOU = 2, NAO_SE_APLICA = 3; // googlefc.ConsentModePurposeStatusEnum
    var PAISES = 'AT BE BG HR CY CZ DK EE FI FR DE GR HU IS IE IT LV LI LT LU MT NL NO PL PT RO SK SI ES SE GB CH GF GP MQ RE YT MF'.split(' ');
    // fusos da Europa que não começam com "Europe/"
    var FUSOS = 'Atlantic/Canary Atlantic/Madeira Atlantic/Azores Atlantic/Reykjavik Atlantic/Faroe Atlantic/Faeroe Arctic/Longyearbyen Asia/Nicosia Asia/Famagusta Africa/Ceuta America/Cayenne America/Guadeloupe America/Martinique America/Marigot Indian/Reunion Indian/Mayotte'.split(' ');

    var fuso = '';
    try { fuso = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
    // sem fuso confiável (vazio, UTC, Etc/...) trata como Europa: na dúvida, espera
    var espera = !/^[A-Za-z]+\/.+/.test(fuso) || /^(Europe|Etc)\//.test(fuso) || FUSOS.indexOf(fuso) > -1;
    var carregado = false;

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    // segunda trava, pela localização que o próprio Google vê (VPN, viajante com relógio de outro país)
    gtag('consent', 'default', { analytics_storage: 'denied', region: PAISES });

    function ligar() {
      window['ga-disable-' + gaId] = false;
      if (carregado) return;
      carregado = true;
      gtag('js', new Date());
      gtag('config', gaId);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
    }

    function pausar() {
      window['ga-disable-' + gaId] = true;
    }

    function apagarCookies() {
      var host = location.hostname;
      document.cookie.split(';').forEach(function (c) {
        var nome = c.split('=')[0].trim();
        if (nome !== '_ga' && nome.indexOf('_ga_') !== 0) return;
        ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
          document.cookie = nome + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
        });
      });
    }

    function decidir() {
      var fc = window.googlefc;
      var valor = fc.getGoogleConsentModeValues ? fc.getGoogleConsentModeValues().analyticsStoragePurposeConsentStatus : 0;
      if (valor === ACEITOU) {
        gtag('consent', 'update', { analytics_storage: 'granted' });
        ligar();
      } else if (valor === RECUSOU) {
        gtag('consent', 'update', { analytics_storage: 'denied' });
        pausar();
        apagarCookies();
      } else if (valor === NAO_SE_APLICA || !espera) {
        ligar();
      } else {
        pausar(); // sem resposta ou opção desligada no AdSense
      }
    }

    var fila = ((window.googlefc = window.googlefc || {}).callbackQueue = window.googlefc.callbackQueue || []);
    fila.push({ CONSENT_MODE_DATA_READY: decidir });
    fila.push({
      CONSENT_API_READY: function () {
        if (typeof window.__tcfapi !== 'function') return;
        window.__tcfapi('addEventListener', 2, function (dados, ok) {
          if (!ok || !dados) return;
          if (dados.eventStatus === 'cmpuishown') {
            // aviso na tela (inclusive ao rever a escolha): para até vir a resposta
            espera = true;
            pausar();
          } else if (dados.eventStatus === 'useractioncomplete') {
            setTimeout(decidir, 0);
          }
        });
      },
    });

    if (espera) pausar();
    else ligar();
  })();
</script>
