---
interface Props { status: 'confirmado' | 'em-verificacao'; canais?: number }
const { status, canais } = Astro.props;
const extra = canais ? ` · ${canais} ${canais > 1 ? 'fontes' : 'fonte'}` : '';
---

<span class={`selo selo--${status}`}>
  {
    status === 'confirmado' ? (
      <>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6.4 4.6 9.5 10.5 2.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Confirmado{extra}
      </>
    ) : (
      <>Em verificação{extra}</>
    )
  }
</span>
