---
// Coluna lateral: anúncio, atalhos de seção, afiliados e anúncio alto.
import Anuncio from './Anuncio.astro';
import { SITE, CATEGORIAS } from '../../site.config.mjs';
import { u, todasDicas, langDaUrl } from '../lib/util';
import { T, nomeCategoria, slugCategoria, prefixo, type Categoria } from '../lib/i18n';
const lang = langDaUrl(Astro.url.pathname);
const t = T[lang];
const dicas = await todasDicas(lang);
const conta = (slug: string) => dicas.filter((d) => d.data.categoria === slug).length;
---

<aside class="lateral">
  <Anuncio formato="retangulo" />
  <div class="caixa">
    <h2>{t.secoes}</h2>
    <ul class="lista-trilhas">
      {(Object.keys(CATEGORIAS) as Categoria[]).map((c) => <li><a href={u(`${prefixo(lang)}/${slugCategoria(c, lang)}/`)}>{nomeCategoria(c, lang)} <span>{conta(c)}</span></a></li>)}
    </ul>
  </div>
  <div class="caixa">
    <h2>{t.lerSelo}</h2>
    <p><strong style="color: var(--menta)">{t.confirmado}:</strong> {t.seloConf}</p>
    <p><strong style="color: var(--ambar)">{t.emVerificacao}:</strong> {t.seloVerif}</p>
  </div>
  {
    SITE.afiliados.length > 0 && lang === 'pt' && (
      <div class="caixa">
        <h2>Para jogar melhor</h2>
        <ul class="afiliados">
          {SITE.afiliados.map((a) => <li><a href={a.url} rel="sponsored nofollow noopener" target="_blank">{a.nome}</a><small>{a.nota}</small></li>)}
        </ul>
        <p style="margin-top: 10px; font-size: 0.78rem; color: var(--nevoa)">Links de afiliado: se você comprar, o site ganha uma comissão e você não paga nada a mais.</p>
      </div>
    )
  }
  <Anuncio formato="arranha" />
</aside>
