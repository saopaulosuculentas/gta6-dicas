---
import Selo from './Selo.astro';
import { u, canais, dataHora, linkDica, langDe, type Dica } from '../lib/util';
import { T, nomeCategoria } from '../lib/i18n';
interface Props { dica: Dica }
const { dica } = Astro.props;
const d = dica.data;
const lang = langDe(dica);
const t = T[lang];
const n = canais(dica).length;
const capa = d.imagens?.[0];
---

<a class="cartao" href={linkDica(dica)}>
  {capa && <div class="cartao__img"><img src={u(`/img/${capa.arquivo}`)} alt="" width="600" height="338" loading="lazy" decoding="async" /></div>}
  <div class="cartao__topo">
    <span class="etiqueta">{nomeCategoria(d.categoria, lang)}</span>
    <Selo status={d.status} />
  </div>
  <h3>{d.titulo}</h3>
  <p>{d.resumo}</p>
  <div class="cartao__pe">
    <time datetime={d.atualizado_em.toISOString()} data-relativo>{dataHora(d.atualizado_em, lang)}</time>
    <span>{n} {n > 1 ? t.fontes : t.fonte}</span>
  </div>
</a>
