---
// Carrossel de imagens oficiais do GTA 6 (capturas publicadas pela Rockstar Games), cada uma levando a uma dica.
import { u, linkSlug, langDaUrl } from '../lib/util';
const lang = langDaUrl(Astro.url.pathname);
const en = lang === 'en';

const SLIDES = [
  { img: 'vice-city-1', lugar: 'Vice City', pt: ['easter-eggs-gta-6-lista', 'Os easter eggs já encontrados'], en: ['gta-6-easter-eggs-list', 'Every easter egg found so far'] },
  { img: 'grassrivers', lugar: 'Grassrivers', pt: ['missao-skunk-ape-rifle-sniper-gta-6', 'A missão secreta do Skunk Ape'], en: ['gta-6-skunk-ape-mission-sniper-rifle', 'The secret Skunk Ape mission'] },
  { img: 'vice-city-2', lugar: 'Vice City', pt: ['como-invadir-aeroporto-roubar-aviao-gta-6', 'Como roubar um avião no aeroporto'], en: ['gta-6-airport-steal-plane', 'How to steal a plane at the airport'] },
  { img: 'ambrosia', lugar: 'Ambrosia', pt: ['como-ganhar-dinheiro-gta-6', 'Como ganhar dinheiro rápido'], en: ['gta-6-how-to-make-money', 'How to make money fast'] },
  { img: 'leonida-keys', lugar: 'Leonida Keys', pt: ['cachorro-jet-ski-ilha-dos-cachorros-gta-6', 'O cachorro do jet ski e a ilha dos cachorros'], en: ['gta-6-jet-ski-dog-location', 'The jet ski dog and Dog Island'] },
  { img: 'mount-kalaga', lugar: 'Mount Kalaga', pt: ['paraquedas-gta-6-onde-pegar', 'Onde pegar paraquedas'], en: ['gta-6-parachute-location', 'Where to get a parachute'] },
  { img: 'port-gellhorn', lugar: 'Port Gellhorn', pt: ['garagens-gta-6-locais-e-precos', 'Todas as garagens e preços'], en: ['gta-6-garage-locations-prices', 'Every garage and price'] },
  { img: 'jason-e-lucia', lugar: 'Jason & Lucia', pt: ['todos-os-codigos-gta-6-lista-completa', 'Todos os 61 códigos do jogo'], en: ['all-gta-6-cheats-list', 'All 61 cheats in the game'] },
] as const;
const credito = en ? 'Official image: Rockstar Games' : 'Imagem oficial: Rockstar Games';
---

<section class="carrossel miolo" aria-roledescription={en ? 'carousel' : 'carrossel'} aria-label={en ? 'GTA 6 official images' : 'Imagens oficiais do GTA 6'} data-carrossel>
  <div class="carrossel__trilho" tabindex="0">
    {
      SLIDES.map((s, i) => {
        const [slug, chamada] = s[lang];
        return (
          <a class="carrossel__item" href={linkSlug(slug, lang)} aria-label={`${s.lugar}: ${chamada}`}>
            <img src={u(`/img/oficial/${s.img}.webp`)} alt={`${s.lugar}, GTA 6`} width="1200" height="675" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            <span class="carrossel__texto">
              <small>{s.lugar}</small>
              <b>{chamada} →</b>
            </span>
          </a>
        );
      })
    }
  </div>
  <div class="carrossel__controles">
    <button type="button" data-ant aria-label={en ? 'Previous image' : 'Imagem anterior'}>‹</button>
    <div class="carrossel__pontos">{SLIDES.map((_, i) => <span data-ponto={i} class={i === 0 ? 'ativo' : ''}></span>)}</div>
    <button type="button" data-prox aria-label={en ? 'Next image' : 'Próxima imagem'}>›</button>
  </div>
  <p class="carrossel__credito">{credito}</p>
</section>

<script is:inline>
  (function () {
    var c = document.querySelector('[data-carrossel]');
    if (!c) return;
    var trilho = c.querySelector('.carrossel__trilho');
    var itens = trilho.children;
    var pontos = c.querySelectorAll('[data-ponto]');
    var atual = 0, parado = false;
    function ir(i) {
      atual = (i + itens.length) % itens.length;
      trilho.scrollTo({ left: itens[atual].offsetLeft - trilho.offsetLeft, behavior: 'smooth' });
    }
    trilho.addEventListener('scroll', function () {
      var i = Math.round(trilho.scrollLeft / trilho.clientWidth);
      if (i !== atual && i < itens.length) atual = i;
      pontos.forEach(function (p, k) { p.classList.toggle('ativo', k === atual); });
    }, { passive: true });
    c.querySelector('[data-ant]').addEventListener('click', function () { parado = true; ir(atual - 1); });
    c.querySelector('[data-prox]').addEventListener('click', function () { parado = true; ir(atual + 1); });
    c.addEventListener('mouseenter', function () { parado = true; });
    c.addEventListener('touchstart', function () { parado = true; }, { passive: true });
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(function () { if (!parado && !document.hidden) ir(atual + 1); }, 5000);
    }
  })();
</script>
