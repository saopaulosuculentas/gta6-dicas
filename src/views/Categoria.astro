---
// Página de seção (Códigos, Easter eggs...), nas duas línguas.
import Base from '../layouts/Base.astro';
import Cartao from '../components/Cartao.astro';
import Anuncio from '../components/Anuncio.astro';
import Lateral from '../components/Lateral.astro';
import TabelaCodigos from '../components/TabelaCodigos.astro';
import SemCodigos from '../components/SemCodigos.astro';
import { u, todasDicas, linkDica, linkSlug } from '../lib/util';
import { T, PAGINAS, infoCategoria, prefixo, type Lang, type Categoria } from '../lib/i18n';

interface Props { lang: Lang; categoria: Categoria }
const { lang, categoria } = Astro.props;
const en = lang === 'en';
const t = T[lang];
const c = infoCategoria(categoria, lang);
const dicas = (await todasDicas(lang)).filter((d) => d.data.categoria === categoria);
const ehCodigos = categoria === 'codigos';
const aqui = u(`${prefixo(lang)}/${c.slug}/`);
const alternativa = { pt: u(`/${categoria}/`), en: u(`/en/${infoCategoria(categoria, 'en').slug}/`) };

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.inicio, item: new URL(u(PAGINAS.inicio[lang]), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: c.nome, item: new URL(aqui, Astro.site).href },
    ],
  },
  ...(dicas.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: c.titulo,
        itemListElement: dicas.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.data.titulo, url: new URL(linkDica(d), Astro.site).href })),
      }]
    : []),
];
---

<Base titulo={c.titulo} descricao={c.descricao} jsonld={jsonld} alternativa={alternativa}>
  <header class="cabeca-pagina miolo">
    <nav class="trilho" aria-label={t.voceEsta}><a href={u(PAGINAS.inicio[lang])}>{t.inicio}</a> <span>/</span> <span>{c.nome}</span></nav>
    <h1>{c.titulo}</h1>
    <p>{c.descricao}</p>
  </header>

  <div class="miolo"><Anuncio formato="faixa" /></div>

  <div class="miolo duas">
    <main>
      {
        ehCodigos && (
          <section class="secao">
            {dicas.length ? <TabelaCodigos dicas={dicas} /> : !en && <SemCodigos />}
          </section>
        )
      }
      {
        !ehCodigos && (
          <section class="secao">
            {dicas.length ? (
              <div class="grade">
                {dicas.map((d, i) => (
                  <>
                    <Cartao dica={d} />
                    {i === 3 && <Anuncio formato="grade" />}
                  </>
                ))}
              </div>
            ) : (
              <div class="aviso">
                <h3>{en ? 'Nothing here yet' : 'Nada confirmado aqui ainda'}</h3>
                <p>{en ? 'This page fills up as finds show up in videos and streams, always with the source.' : 'Esta página enche conforme as descobertas aparecem em vídeos e lives, sempre com a fonte.'}</p>
              </div>
            )}
          </section>
        )
      }
      {ehCodigos && dicas.length > 0 && <Anuncio formato="artigo" />}
      {
        ehCodigos && !en && (
          <section class="secao texto">
            <h2>Como usar código no GTA 6</h2>
            <p>
              Primeiro zere a história principal: nenhum código funciona antes disso. Depois, abra o celular do personagem com o direcional para cima,
              segure L1 e R1 (LB e RB no Xbox) e digite a sequência no direcional. Cada código ainda precisa ser liberado com o seu desafio, e ativar
              qualquer um desliga os troféus e o salvamento até você sair do jogo.
            </p>
            <p>
              A lista dos 61 códigos está em <a href={linkSlug('todos-os-codigos-gta-6-lista-completa', 'pt')}>todos os códigos do GTA 6</a>, e o passo a
              passo em <a href={linkSlug('codigos-gta-6-como-usar', 'pt')}>como usar e desbloquear os códigos</a>.
            </p>
            <h2>O que significa cada selo</h2>
            <p>
              <strong>Confirmado</strong> quer dizer que o código apareceu em duas fontes independentes ou veio da própria Rockstar.
              <strong>Em verificação</strong> quer dizer que, por enquanto, só uma fonte publicou. Os códigos em verificação podem mudar.
            </p>
          </section>
        )
      }
      {
        ehCodigos && en && (
          <section class="secao texto">
            <h2>How to use cheats in GTA 6</h2>
            <p>
              First, beat the main story: no cheat works before that. Then open your phone with Up on the D-pad, hold L1 and R1 (LB and RB on Xbox)
              and enter the sequence on the D-pad. Each cheat also has to be unlocked with its own challenge, and using any cheat turns off trophies
              and saving until you quit the game.
            </p>
            <p>
              The full list is in <a href={linkSlug('all-gta-6-cheats-list', 'en')}>every GTA 6 cheat</a>, and the step by step in
              <a href={linkSlug('how-to-use-cheats-gta-6', 'en')}>how to use and unlock cheats</a>.
            </p>
            <h2>What each badge means</h2>
            <p>
              <strong>Confirmed</strong> means the cheat showed up in two independent sources or came from Rockstar itself.
              <strong>Unverified</strong> means only one source has published it so far, so it may change.
            </p>
          </section>
        )
      }
    </main>
    <Lateral />
  </div>
</Base>
